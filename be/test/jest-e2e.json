{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^generated/prisma$": "<rootDir>/generated/prisma",
    "^@paralleldrive/cuid2$": "<rootDir>/test/stubs/cuid2.js"
  },
  "setupFilesAfterEnv": [
    "<rootDir>/test/setup.ts"
  ],
  "testTimeout": 30000,
  "maxWorkers": 1
}
