NODE_ENV=development
PORT=3000

# DATABASE
DATABASE_URL="mysql://root:root@localhost:13308/dokabot"

# AUTH
# openssl rand -base64 48   (>= 32 chars, the app refuses to boot on a weak value)
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# KEY VAULT — master key that wraps per-record data keys for exchange credentials.
# openssl rand -base64 32   (must decode to exactly 32 bytes)
# In production this is replaced by AWS KMS / Vault Transit; see docs/ARCHITECTURE.md §2.4
KEY_VAULT_MASTER_KEY=""
KEY_VAULT_KEY_ID="local-master-v1"

# Comma-separated list of allowed front-end origins. Required in production.
CORS_ORIGINS="http://localhost:3001"

# TRADING
# Global kill switch — "true" rejects every new order across the platform.
TRADING_KILL_SWITCH=false
# Number of strategy-worker shards a bot can be pinned to.
STRATEGY_SHARD_COUNT=16
# Set to "false" to stop this instance from reconciling orders.
RECONCILER_ENABLED=true
# Set to "false" to stop this instance from running bots (e.g. an API-only pod).
RUNNER_ENABLED=true
# Horizontal scaling: each worker takes the shards where shardId % WORKER_COUNT
# equals WORKER_SHARD_INDEX. Leave unset to run every shard in one process.
# WORKER_SHARD_INDEX=0
WORKER_COUNT=1

# LEGACY single-tenant strategy runners (off by default, see docs/ARCHITECTURE.md §3)
RUN_LEGACY_STRATEGIES=false
STRATEGY="ema-macd"
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_TESTNET=

# BOT
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
