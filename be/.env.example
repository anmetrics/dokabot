# DATABASE
DATABASE_URL="mysql://root:root@localhost:13308/dokabot"

#JWT
JWT_SECRET="secret"
JWT_TOKEN_EXPIRES_IN="100d"

BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_TESTNET=       # set =1 to use testnet

# BOT
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""


# === ALCHEMY (miễn phí) ===
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# === WALLET (có ít nhất 0.1 ETH để gas) ===
PRIVATE_KEY=0xabc123...your_real_private_key

# === CONTRACT (deploy trước) ===
CONTRACT_ADDRESS=0xYourFlashArbContractAddress

# === FLASHBOTS (bảo vệ tx) ===
FLASHBOTS_RELAY=https://rpc.flashbots.net
FLASHBOTS_PROTECT=true

# === SETTINGS ===
MIN_PROFIT_MODE_A=0.008
MIN_PROFIT_MODE_B=0.02
MAX_HOPS=3