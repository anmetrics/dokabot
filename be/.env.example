NODE_ENV=development
PORT=3000

# DATABASE
DATABASE_URL="mysql://root:root@localhost:13308/dokabot"

# AUTH
# openssl rand -base64 48   (>= 32 chars, the app refuses to boot on a weak value)
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# KEY VAULT — master key that wraps per-record data keys for exchange credentials.
# openssl rand -base64 32   (must decode to exactly 32 bytes)
# In production this is replaced by AWS KMS / Vault Transit; see docs/ARCHITECTURE.md §2.4
KEY_VAULT_MASTER_KEY=""
KEY_VAULT_KEY_ID="local-master-v1"

# PLATFORM EGRESS — the static outbound IPs every exchange call leaves from
# (NAT gateway / static-IP worker pool). Shown to users on the "add API key"
# screen so they can lock their exchange key to this platform. Comma-separated
# IPv4 addresses or CIDR blocks. Leave empty in local dev — the UI then tells the
# user IP allowlisting is unavailable instead of showing a wrong IP.
PLATFORM_EGRESS_IPS=""

# Comma-separated list of allowed front-end origins. Required in production.
CORS_ORIGINS="http://localhost:3001"

# RATE LIMIT — defaults in code are the production values. Uncomment to loosen
# them for local development only.
# THROTTLE_LIMIT=12000
# THROTTLE_LOGIN_LIMIT=1000
# THROTTLE_REGISTER_LIMIT=500

# BILLING (BSC) — see contracts/README.md
# Leave BILLING_RPC_URL empty to run without on-chain billing: the API still
# reports plans and status, it just never sees a payment.
BILLING_RPC_URL=""
BILLING_WS_URL=""
BILLING_CHAIN_ID=56
BILLING_TESTNET=false
BILLING_CONTRACT_ADDRESS=""
# Block the contract was deployed at, so the first sync does not scan from genesis.
BILLING_START_BLOCK=0
# BSC-USD. 18 decimals, NOT the 6 that USDT uses on Ethereum.
BILLING_TOKEN_ADDRESS="0x55d398326f99059fF775485246999027B3197955"
BILLING_TOKEN_DECIMALS=18

# TRADING
# Global kill switch — "true" rejects every new order across the platform.
TRADING_KILL_SWITCH=false
# Number of strategy-worker shards a bot can be pinned to.
STRATEGY_SHARD_COUNT=16
# Set to "false" to stop this instance from reconciling orders.
RECONCILER_ENABLED=true
# Set to "false" to stop this instance from running bots (e.g. an API-only pod).
RUNNER_ENABLED=true
# Horizontal scaling: each worker takes the shards where shardId % WORKER_COUNT
# equals WORKER_SHARD_INDEX. Leave unset to run every shard in one process.
# WORKER_SHARD_INDEX=0
WORKER_COUNT=1
