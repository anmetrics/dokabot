// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Multi-tenant foundation (Phase 1)
// ─────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique @map("email")
  passwordHash String     @map("password_hash")
  role         UserRole   @default(USER) @map("role")
  status       UserStatus @default(ACTIVE) @map("status")
  mfaSecret    String?    @map("mfa_secret")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  lastLoginAt  DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  exchangeAccounts ExchangeAccount[]
  auditLogs        AuditLog[]
  bots             Bot[]
  orders           Order[]
  settings         UserSettings?
  walletLinks      WalletLink[]
  subscription     Subscription?

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.Text
  ip        String?   @map("ip")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum Exchange {
  BINANCE
  BYBIT
}

enum ExchangeAccountStatus {
  ACTIVE
  INVALID
  REVOKED
}

/// API credentials of a user, stored with envelope encryption.
/// The plaintext secret NEVER leaves the key vault and is never returned to a client.
model ExchangeAccount {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  exchange Exchange @map("exchange")
  label    String   @map("label")

  /// Public part of the key. Only the last 4 chars are ever exposed via API.
  apiKeyCiphertext String @map("api_key_ciphertext") @db.Text
  apiKeyLast4      String @map("api_key_last4")

  secretCiphertext String @map("secret_ciphertext") @db.Text

  /// Envelope encryption metadata (see docs/ARCHITECTURE.md §2.4)
  iv         String @map("iv")
  authTag    String @map("auth_tag")
  wrappedDek String @map("wrapped_dek") @db.Text
  kmsKeyId   String @map("kms_key_id")

  isTestnet      Boolean               @default(false) @map("is_testnet")
  permissions    Json?                 @map("permissions")
  canWithdraw    Boolean               @default(false) @map("can_withdraw")
  status         ExchangeAccountStatus @default(ACTIVE) @map("status")
  lastVerifiedAt DateTime?             @map("last_verified_at")
  lastError      String?               @map("last_error") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bots Bot[]

  @@unique([userId, exchange, label])
  @@index([userId])
  @@map("exchange_accounts")
}

/// Append-only trail for every security- or money-relevant action.
model AuditLog {
  id           String  @id @default(uuid())
  userId       String? @map("user_id")
  action       String  @map("action")
  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id")
  ip           String? @map("ip")
  userAgent    String? @map("user_agent") @db.Text
  metadata     Json?   @map("metadata")
  success      Boolean @default(true) @map("success")

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Trading (Phase 2)
// ─────────────────────────────────────────────────────────────

enum BotStatus {
  DRAFT
  RUNNING
  PAUSED
  STOPPED
  ERROR
}

model Bot {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  exchangeAccountId String    @map("exchange_account_id")
  strategyKey       String    @map("strategy_key")
  symbol            String    @map("symbol")
  timeframe         String    @map("timeframe")
  config            Json      @map("config")
  status            BotStatus @default(DRAFT) @map("status")

  /// Deterministic assignment to a strategy worker: hash(id) % shardCount.
  shardId Int @default(0) @map("shard_id")

  /// Paper bots run the full pipeline but never reach the exchange.
  isPaper Boolean @default(true) @map("is_paper")

  /// Hard per-bot loss limit. The bot stops itself when realised loss exceeds it.
  maxLossUsd Decimal? @map("max_loss_usd") @db.Decimal(38, 18)

  lastError    String?   @map("last_error") @db.Text
  lastSignalAt DateTime? @map("last_signal_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Restrict)
  orders          Order[]

  @@index([userId])
  @@index([status, shardId])
  @@map("bots")
}

enum OrderState {
  PENDING
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
  EXPIRED
}

model Order {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  botId             String? @map("bot_id")
  exchangeAccountId String  @map("exchange_account_id")

  exchange Exchange @map("exchange")
  symbol   String   @map("symbol")
  side     String   @map("side")
  type     String   @map("type")

  /// Deterministic idempotency key. A replay of the same intent reuses this row
  /// instead of sending a second order to the exchange.
  clientOrderId   String  @unique @map("client_order_id")
  exchangeOrderId String? @map("exchange_order_id")

  price          Decimal @default(0) @map("price") @db.Decimal(38, 18)
  quantity       Decimal @map("quantity") @db.Decimal(38, 18)
  filledQuantity Decimal @default(0) @map("filled_quantity") @db.Decimal(38, 18)
  averagePrice   Decimal @default(0) @map("average_price") @db.Decimal(38, 18)

  state     OrderState @default(PENDING) @map("state")
  isPaper   Boolean    @default(false) @map("is_paper")
  lastError String?    @map("last_error") @db.Text
  raw       Json?      @map("raw")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([botId, createdAt])
  @@index([state])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────────
// Per-user settings (Phase 2g)
// ─────────────────────────────────────────────────────────────

/// Account-wide preferences and defaults, one row per user.
///
/// Replaces the old global `settings` key/value table, which had one hardcoded
/// row per coin and could only ever describe a single tenant.
model UserSettings {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Defaults applied to newly created bots, so a user sets them once.
  defaultOrderSizeUsd      Decimal  @default(50) @map("default_order_size_usd") @db.Decimal(38, 18)
  defaultTakeProfitPercent Decimal  @default(2) @map("default_take_profit_percent") @db.Decimal(10, 4)
  defaultStopLossPercent   Decimal  @default(1) @map("default_stop_loss_percent") @db.Decimal(10, 4)
  defaultMaxLossUsd        Decimal? @map("default_max_loss_usd") @db.Decimal(38, 18)

  /// Account-wide ceiling on how much is at risk across every bot at once.
  maxConcurrentBots Int      @default(20) @map("max_concurrent_bots")
  maxDailyLossUsd   Decimal? @map("max_daily_loss_usd") @db.Decimal(38, 18)

  /// Per-user kill switch, independent of the platform-wide one.
  tradingPaused Boolean @default(false) @map("trading_paused")

  /// Price guards per symbol, unbounded in length — the point of replacing the
  /// old fixed BNB/SOL/BTC fields. See SymbolRule in settings.types.ts.
  symbolRules Json @default("[]") @map("symbol_rules")

  notifyOnFill       Boolean @default(true) @map("notify_on_fill")
  notifyOnError      Boolean @default(true) @map("notify_on_error")
  notifyOnBotStopped Boolean @default(true) @map("notify_on_bot_stopped")
  telegramChatId     String? @map("telegram_chat_id")

  timezone String @default("Asia/Ho_Chi_Minh") @map("timezone")
  locale   String @default("vi") @map("locale")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─────────────────────────────────────────────────────────────
// Billing (Phase 2h) — see contracts/README.md
// ─────────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  NONE
  /// Paid and inside the current period.
  ACTIVE
  /// Period ended, payment not yet collected. Still has access.
  GRACE
  /// Grace elapsed without payment.
  EXPIRED
  /// User revoked on-chain.
  CANCELLED
}

/// A wallet the user has proven they control, by signing a nonce.
model WalletLink {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// Lower-cased checksum-free address, so lookups are exact.
  address String @unique @map("address")
  chainId Int    @map("chain_id")

  /// Nonce the user signed. Kept to reject a replayed signature.
  nonce      String    @map("nonce")
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_links")
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  tier   PlanTier           @default(FREE) @map("tier")
  status SubscriptionStatus @default(NONE) @map("status")

  /// Wallet that pays. Null while the user is on the free tier.
  walletAddress String? @map("wallet_address")

  priceUsd Decimal @default(4) @map("price_usd") @db.Decimal(18, 6)

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  /// Access survives until here even after the period ends.
  graceEndsAt        DateTime? @map("grace_ends_at")

  cancelledAt DateTime? @map("cancelled_at")
  lastError   String?   @map("last_error") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// One confirmed on-chain charge.
model Payment {
  id             String @id @default(uuid())
  subscriptionId String @map("subscription_id")
  userId         String @map("user_id")

  /// Idempotency key is the log's position on chain, not the user — the same
  /// wallet pays many times, and a reorg can replay a block.
  txHash   String @map("tx_hash")
  logIndex Int    @map("log_index")

  blockNumber   BigInt   @map("block_number")
  walletAddress String   @map("wallet_address")
  amountUsd     Decimal  @map("amount_usd") @db.Decimal(18, 6)
  /// Raw on-chain amount, in the token's smallest unit.
  amountRaw     String   @map("amount_raw")
  chargeCount   Int      @map("charge_count")
  confirmedAt   DateTime @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([txHash, logIndex])
  @@index([userId, createdAt])
  @@map("payments")
}

/// How far the chain listener has processed, so a restart resumes instead of
/// rescanning from genesis or silently skipping blocks.
model ChainCursor {
  id                 String   @id @default(uuid())
  chainId            Int      @map("chain_id")
  contractAddress    String   @map("contract_address")
  lastProcessedBlock BigInt   @map("last_processed_block")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([chainId, contractAddress])
  @@map("chain_cursors")
}
