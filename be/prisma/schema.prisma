// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Setting {
  id         String   @id @default(uuid())
  key        String   @unique @map("key")      
  value      String   @map("value")             

  createdAt   DateTime  @default(now()) @map("created_at") 
  updatedAt      DateTime? @updatedAt  @map("updated_at") 

  @@map("settings")
}


enum Exchange {
  BINANCE
  OKX
  BYBIT
  BITGET
  BINGX
}


model ExchangeAPI {
  id         Int       @id @default(autoincrement())
  userId     Int
  exchange   Exchange
  apiKey     String    // encrypted
  apiSecret  String    // encrypted
  passphrase String?   // OKX, Bitget, BingX required

  isReadOnly Boolean   @default(false)
  nickname   String?   // VD: "Future account", "Main Spot"

  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id])

  @@unique([userId, exchange, apiKey])

  @map("exchange_api")
}


enum PositionSide {
  LONG
  SHORT
  NONE
}

model Position {
  id             String   @id @default(uuid())
  buyPrice       Float @map("buy_price")
  strategy       String   @map("strategy")
    symbol       String   @map("symbol")
  qty            Float @map("qty")
  future_side        PositionSide? @default("NONE")
  isFuture Boolean @map("is_future") @default(false)
  usdSpent       Float @map("usd_spent")
  totalQtyActual Float  @map("total_qty_actual")
  sellPrice      Float? @map("sell_price")
  isDualInvestment Boolean @map("is_dual_investment") @default(false)
  dcaIndex       Int @map("dca_index")

  createdAt   DateTime  @default(now()) @map("created_at") 
  updatedAt      DateTime? @updatedAt  @map("updated_at") 

   @@map("positions")
}

model SellSuccess {
  id                       String   @id @default(uuid())
  symbol                   String   @map("symbol")
  buyPrices                 Json   @map("buy_prices")
  sellPrice                Float  @map("sell_prices")
  totalAmountBuyActual     Float @map("total_amount_buy_actual")
  totalAmountBuyUsdtSpent  Float @map("total_amount_buy_usd_spent")
  totalProfit              Float  @map("total_profit")
  totalRevenueUsdt         Float @map("total_revenue_usdt")

  createdAt   DateTime  @default(now()) @map("created_at") 
  updatedAt      DateTime? @updatedAt  @map("updated_at") 

  @@map("sell_successes")
}
