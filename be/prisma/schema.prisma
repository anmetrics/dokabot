// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique @map("email")
  password  String   @map("password")  // Hashed password
  name      String?  @map("name")
  isActive  Boolean  @default(true) @map("is_active")

  credentials PlatformCredential[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt  @map("updated_at")

  @@map("users")
}

model PlatformCredential {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  platform      String   @map("platform")  // e.g., 'binance', 'okx', 'bybit'
  name          String   @map("name")      // User-friendly name for this credential set
  apiKey        String   @map("api_key")
  apiSecret     String   @map("api_secret")
  isTestnet     Boolean  @default(false) @map("is_testnet")
  isActive      Boolean  @default(true) @map("is_active")  // To enable/disable credentials
  whitelistIps  String?  @map("whitelist_ips") @db.Text  // Comma-separated IPs
  description   String?  @map("description") @db.Text

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt  @map("updated_at")

  @@unique([userId, platform, name])
  @@index([platform])
  @@index([isActive])
  @@map("platform_credentials")
}

model Setting {
  id         String   @id @default(uuid())
  key        String   @unique @map("key")      
  value      String   @map("value")             

  createdAt   DateTime  @default(now()) @map("created_at") 
  updatedAt      DateTime? @updatedAt  @map("updated_at") 

  @@map("settings")
}

model Position {
  id             String   @id @default(uuid())
  buyPrice       Float @map("buy_price")
  strategy       String   @map("strategy")
    symbol       String   @map("symbol")
  qty            Float @map("qty")
  usdSpent       Float @map("usd_spent")
  totalQtyActual Float  @map("total_qty_actual")
  sellPrice      Float? @map("sell_price")
  isDualInvestment Boolean @map("is_dual_investment") @default(false)
  dcaIndex       Int @map("dca_index")

  createdAt   DateTime  @default(now()) @map("created_at") 
  updatedAt      DateTime? @updatedAt  @map("updated_at") 

   @@map("positions")
}

model SellSuccess {
  id                       String   @id @default(uuid())
  symbol                   String   @map("symbol")
  buyPrices                 Json   @map("buy_prices")
  sellPrice                Float  @map("sell_prices")
  totalAmountBuyActual     Float @map("total_amount_buy_actual")
  totalAmountBuyUsdtSpent  Float @map("total_amount_buy_usd_spent")
  totalProfit              Float  @map("total_profit")
  totalRevenueUsdt         Float @map("total_revenue_usdt")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt  @map("updated_at")

  @@map("sell_successes")
}
