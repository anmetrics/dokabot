# Test-only values, safe to commit. Real secrets live in .env (gitignored).
NODE_ENV=test
PORT=3999

# Separate database: the suite truncates tables between tests.
DATABASE_URL="mysql://root:root@localhost:13308/dokabot_test"

JWT_SECRET="test-only-secret-that-is-long-enough-to-pass-validation-0123456789"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

KEY_VAULT_MASTER_KEY="a2tra2tra2tra2tra2tra2tra2tra2tra2tra2tra2s="
KEY_VAULT_KEY_ID="test-master-v1"

CORS_ORIGINS="http://localhost:3001"

TRADING_KILL_SWITCH=false
STRATEGY_SHARD_COUNT=16
# The reconciler cron would race the assertions.
RECONCILER_ENABLED=false
# The runner cron would race the assertions; specs drive it directly.
RUNNER_ENABLED=false

# Limits are raised so the rate limiter does not decide the outcome of tests that
# are about something else. throttling.e2e-spec.ts sets its own low values.
THROTTLE_LIMIT=100000
THROTTLE_LOGIN_LIMIT=100000
THROTTLE_REGISTER_LIMIT=100000
THROTTLE_REFRESH_LIMIT=100000
