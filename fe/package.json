{
  "private": true,
  "version": "0.1.66",
  "name": "doka",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "setup": "yarn setup:create-env",
    "setup:create-env": "cp .env.template .env",
    "lint": "eslint --ext .ts,.js,.vue .",
    "start": "env $(grep -v '^#' ./.env) nuxt start",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "patch-package && nuxt prepare",
    "staging:delete-tag": "git fetch --tags && git push origin --delete $(git tag -l 'staging-*') || true && git fetch origin --prune 'refs/tags/*:refs/tags/*'",
    "staging:deploy": "yarn staging:delete-tag && TAG=`echo staging-$(date +%Y%m%d-%H%M%S)` && git tag $TAG && git push origin $TAG",
    "preview:delete-tag": "git fetch --tags && git push origin --delete $(git tag -l 'preview-*') || true && git fetch origin --prune 'refs/tags/*:refs/tags/*'",
    "preview:deploy": "yarn preview:delete-tag && TAG=`echo preview-$(date +%Y%m%d-%H%M%S)` && git tag $TAG && git push origin $TAG"
  },
  "dependencies": {
    "@infectoone/vue-ganttastic": "^2.1.4",
    "@pinia/nuxt": "^0.4.6",
    "@vee-validate/nuxt": "^4.9.5",
    "@vee-validate/zod": "^4.9.5",
    "@zodios/core": "^10.9.0",
    "axios": "^1.4.0",
    "binance-api-node": "^0.12.9",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^2.0.0",
    "dayjs": "^1.11.7",
    "ky": "^0.33.2",
    "ky-universal": "^0.11.0",
    "lightweight-charts": "^5.0.8",
    "lodash": "^4.17.21",
    "patch-package": "^7.0.0",
    "pinia": "^2.0.30",
    "postinstall-postinstall": "^2.1.0",
    "qr-code-styling": "^1.9.2",
    "vee-validate": "^4.9.5",
    "vuetify": "^3.1.2",
    "zod": "^3.21.4",
    "zodios-plugin-ky": "^0.1.4"
  },
  "devDependencies": {
    "@mdi/font": "^7.1.96",
    "@nuxt/eslint-config": "^0.1.1",
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@types/lodash": "^4.14.191",
    "@types/node": "^18.13.0",
    "eslint": "^8.33.0",
    "nuxt": "^3.1.1",
    "sass": "^1.58.0",
    "sass-loader": "^13.2.0",
    "typescript": "^4.9.5",
    "vite-plugin-vuetify": "^1.0.2"
  },
  "engines": {
    "node": "19.0.0"
  },
  "volta": {
    "node": "16.19.0",
    "yarn": "1.22.17"
  }
}
